# ===========================================
# Family Guardian - Environment Variables Example
# ===========================================
# Copy this file to server/.env and fill in values.
# NEVER commit the real .env file!
# ===========================================

# --- Server ---
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/family-guardian?retryWrites=true&w=majority

# --- JWT Auth ---
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars

# --- PayPal Sandbox ---
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Set to 'true' to force mock mode if PayPal sandbox is flaky or down:
PAYPAL_MOCK=false

# --- Google Gemini AI ---
# From https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key

# --- Mailtrap (Sandbox Email) ---
# From https://mailtrap.io/ (Email Testing > Inboxes)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-username
MAILTRAP_PASS=your-mailtrap-password

# --- Frontend URL (CORS & Guardian Email Links) ---
CLIENT_URL=http://localhost:5173
